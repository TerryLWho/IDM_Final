let playerX, playerY;
const playerRadius = 14;
const playerSpeed = 5.2;

let invaders = [];
const invaderRows = 4;
const invaderCols = 8;
const invaderRadius = 13;
let invaderXSpacing = 50;
let invaderYSpacing = 45;
let invaderOffsetX = 55;
let invaderOffsetY = 65;

let invaderDirection = 1;
let invaderStepDown = 14;
let invaderSpeed = 0.4;

let covers = [];
const coverWidth = 38;
const coverHeight = 18;

let playerBullets = [];
let invaderBullets = [];
const bulletSpeed = -6.5;
const invaderBulletSpeed = 2.5;
const bulletRadius = 4;
const maxPlayerBullets = 2;
let playerShootCooldown = 0;
const shootDelay = 25;

let invaderShootTimer = 0;
const invaderShootInterval = 80;

let gameState = "playing";
let matchStartTime = 0;
let matchDuration = 0;

let starField = [];

function setup() {
  createCanvas(600, 500);
  rectMode(CENTER);
  ellipseMode(CENTER);
  
  for (let i = 0; i < 90; i++) {
    starField.push({
      x: random(width),
      y: random(height),
      size: random(1.2, 2.8),
      brightness: random(140, 240)
    });
  }
  
  resetGame();
}

function draw() {
  background(10, 14, 28);
  drawStars();
  drawCovers();
  
  if (gameState === "playing") {
    matchDuration = (millis() - matchStartTime) / 1000;
    
    updateInvaders();
    drawInvaders();
    updatePlayer();
    drawPlayer();
    updatePlayerBullets();
    updateInvaderBullets();
    handlePlayerShooting();
    handleInvaderShooting();
    checkPlayerBulletCollisions();
    checkInvaderBulletCollisions();
    checkPlayerInvaderCollision();
    
    if (invaders.length === 0) {
      gameState = "win";
      matchDuration = (millis() - matchStartTime) / 1000;
    }
    
    // Draw timer
    fill(255);
    textSize(18);
    textAlign(LEFT, TOP);
    text("Time: " + matchDuration.toFixed(1) + "s", 15, 15);
  } else {
    drawEndScreen();
  }
}

function resetGame() {
  playerX = width / 2;
  playerY = height - 65;
  invaders = [];
  playerBullets = [];
  invaderBullets = [];
  invaderDirection = 1;
  invaderSpeed = 0.4;
  playerShootCooldown = 0;
  invaderShootTimer = 0;
  gameState = "playing";
  matchStartTime = millis();
  matchDuration = 0;
  
  for (let row = 0; row < invaderRows; row++) {
    for (let col = 0; col < invaderCols; col++) {
      let x = invaderOffsetX + col * invaderXSpacing;
      let y = invaderOffsetY + row * invaderYSpacing;
      invaders.push({ x: x, y: y, alive: true });
    }
  }
  
  covers = [];
  // 4 barriers like traditional Space Invaders
  let barrierPositions = [100, 230, 370, 500];
  for (let i = 0; i < barrierPositions.length; i++) {
    covers.push({ 
      x: barrierPositions[i], 
      y: height - 120, 
      w: coverWidth, 
      h: coverHeight, 
      health: 3, 
      active: true 
    });
  }
}

function drawStars() {
  noStroke();
  for (let s of starField) {
    fill(255, 255, 200, s.brightness);
    circle(s.x, s.y, s.size);
  }
}

function drawCovers() {
  noStroke();
  for (let cover of covers) {
    if (!cover.active) continue;
    fill(60, 160, 70);
    rect(cover.x, cover.y, cover.w, cover.h, 4);
    fill(90, 200, 100, 180);
    rect(cover.x, cover.y - 2, cover.w - 6, cover.h - 6, 3);
    if (cover.health <= 2) {
      fill(30, 90, 30, 160);
      rect(cover.x, cover.y, cover.w - 4, cover.h - 4, 3);
    }
  }
}

function updatePlayer() {
  if (gameState !== "playing") return;
  if (keyIsDown(LEFT_ARROW)) {
    playerX = constrain(playerX - playerSpeed, playerRadius, width - playerRadius);
  }
  if (keyIsDown(RIGHT_ARROW)) {
    playerX = constrain(playerX + playerSpeed, playerRadius, width - playerRadius);
  }
}

function drawPlayer() {
  noStroke();
  fill(70, 220, 90);
  circle(playerX, playerY, playerRadius * 2);
  fill(180, 255, 190, 200);
  circle(playerX - 2, playerY - 4, playerRadius * 0.7);
}

function updateInvaders() {
  if (invaders.length === 0) return;
  
  let moveAmount = invaderSpeed * invaderDirection;
  let edgeReached = false;
  
  for (let inv of invaders) {
    if (!inv.alive) continue;
    inv.x += moveAmount;
    if (inv.x - invaderRadius <= 5 || inv.x + invaderRadius >= width - 5) {
      edgeReached = true;
    }
  }
  
  if (edgeReached) {
    invaderDirection *= -1;
    for (let inv of invaders) {
      if (!inv.alive) continue;
      inv.y += invaderStepDown;
      if (inv.y + invaderRadius >= playerY - 10) {
        gameState = "lose";
        matchDuration = (millis() - matchStartTime) / 1000;
        return;
      }
    }
    invaderSpeed = min(invaderSpeed + 0.08, 1.5);
  }
}

function drawInvaders() {
  noStroke();
  for (let inv of invaders) {
    if (!inv.alive) continue;
    fill(255, 250, 240);
    circle(inv.x, inv.y, invaderRadius * 2);
  }
}

function handlePlayerShooting() {
  if (gameState !== "playing") return;
  if (playerShootCooldown > 0) {
    playerShootCooldown--;
  }
  
  if (keyIsDown(32) && playerShootCooldown <= 0) {
    if (playerBullets.length < maxPlayerBullets) {
      playerBullets.push({
        x: playerX,
        y: playerY - playerRadius - 2,
        vy: bulletSpeed,
        active: true
      });
      playerShootCooldown = shootDelay;
    }
  }
}

function updatePlayerBullets() {
  for (let bullet of playerBullets) {
    bullet.y += bullet.vy;
    if (bullet.y < -10) bullet.active = false;
  }
  playerBullets = playerBullets.filter(b => b.active);
  
  noStroke();
  fill(255, 255, 100);
  for (let b of playerBullets) {
    circle(b.x, b.y, bulletRadius * 2);
  }
}

function updateInvaderBullets() {
  for (let bullet of invaderBullets) {
    bullet.y += bullet.vy;
    if (bullet.y > height + 10) bullet.active = false;
  }
  invaderBullets = invaderBullets.filter(b => b.active);
  
  noStroke();
  fill(255, 220, 100);
  for (let b of invaderBullets) {
    circle(b.x, b.y, bulletRadius * 1.8);
  }
}

function handleInvaderShooting() {
  if (gameState !== "playing" || invaders.length === 0) return;
  
  invaderShootTimer--;
  if (invaderShootTimer <= 0) {
    let aliveInvaders = invaders.filter(inv => inv.alive);
    if (aliveInvaders.length > 0) {
      let shooter = random(aliveInvaders);
      invaderBullets.push({
        x: shooter.x,
        y: shooter.y + invaderRadius + 2,
        vy: invaderBulletSpeed,
        active: true
      });
    }
    invaderShootTimer = floor(random(invaderShootInterval * 0.7, invaderShootInterval * 1.3));
  }
}

function checkPlayerBulletCollisions() {
  for (let bullet of playerBullets) {
    if (!bullet.active) continue;
    
    for (let cover of covers) {
      if (!cover.active) continue;
      if (bullet.x > cover.x - cover.w/2 && bullet.x < cover.x + cover.w/2 &&
          bullet.y > cover.y - cover.h/2 && bullet.y < cover.y + cover.h/2) {
        cover.health--;
        bullet.active = false;
        if (cover.health <= 0) cover.active = false;
        break;
      }
    }
    if (!bullet.active) continue;
    
    for (let inv of invaders) {
      if (!inv.alive) continue;
      let d = dist(bullet.x, bullet.y, inv.x, inv.y);
      if (d < invaderRadius + bulletRadius) {
        inv.alive = false;
        bullet.active = false;
        break;
      }
    }
  }
  invaders = invaders.filter(inv => inv.alive);
}

function checkInvaderBulletCollisions() {
  for (let bullet of invaderBullets) {
    if (!bullet.active) continue;
    
    for (let cover of covers) {
      if (!cover.active) continue;
      if (bullet.x > cover.x - cover.w/2 && bullet.x < cover.x + cover.w/2 &&
          bullet.y > cover.y - cover.h/2 && bullet.y < cover.y + cover.h/2) {
        cover.health--;
        bullet.active = false;
        if (cover.health <= 0) cover.active = false;
        break;
      }
    }
    if (!bullet.active) continue;
    
    let d = dist(bullet.x, bullet.y, playerX, playerY);
    if (d < playerRadius + bulletRadius) {
      gameState = "lose";
      matchDuration = (millis() - matchStartTime) / 1000;
      bullet.active = false;
      break;
    }
  }
}

function checkPlayerInvaderCollision() {
  if (gameState !== "playing") return;
  for (let inv of invaders) {
    if (!inv.alive) continue;
    let d = dist(playerX, playerY, inv.x, inv.y);
    if (d < playerRadius + invaderRadius) {
      gameState = "lose";
      matchDuration = (millis() - matchStartTime) / 1000;
      break;
    }
  }
}

function drawEndScreen() {
  noStroke();
  fill(0, 0, 0, 180);
  rect(width/2, height/2, width, height);
  
  textAlign(CENTER, CENTER);
  textSize(42);
  textStyle(BOLD);
  
  if (gameState === "win") {
    fill(180, 255, 180);
    text("🌟 VICTORY! 🌟", width/2, height/2 - 45);
  } else if (gameState === "lose") {
    fill(255, 140, 140);
    text("💥 GAME OVER 💥", width/2, height/2 - 45);
  }
  
  fill(255, 255, 200);
  textSize(22);
  textStyle(NORMAL);
  text("Time: " + matchDuration.toFixed(1) + " seconds", width/2, height/2 + 15);
  
  fill(210, 210, 255);
  textSize(18);
  text("Press 'R' to restart", width/2, height/2 + 65);
}

function keyPressed() {
  if (gameState !== "playing" && (key === 'r' || key === 'R')) {
    resetGame();
  }
  return false;
}
